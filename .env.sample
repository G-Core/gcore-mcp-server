# Gcore MCP server settings. Copy to .env for local development, or set them in
# your client's MCP config. Only GCORE_API_KEY is required; every other line shows
# the default and when to change it. README: "Configuration reference".
# Booleans take 1/true/yes/on or 0/false/no/off; anything else stops the server.

# ---------------------------------------------------------------- account
# Required. Create one at https://docs.gcore.com/account-settings/api-tokens#create-an-api-token
# For a hard read-only guarantee, use a token of a user with a read-only role
# (GCORE_READ_ONLY limits only this server, not the key).
GCORE_API_KEY=

# Pin cloud calls to one project / region. Default: unset - the account's
# default project is used (results say which) and list calls search every
# region. Pin them when an agent should only ever touch one project or region.
# GCORE_CLOUD_PROJECT_ID=
# GCORE_CLOUD_REGION_ID=

# Default: https://api.gcore.com. Change only for a non-production endpoint.
# GCORE_BASE_URL=https://api.gcore.com

# Seconds a *_and_poll call (create/delete/resize... and wait) waits for its task.
# Default: 50. A longer task - a load balancer takes ~90 s, a Kubernetes cluster
# many minutes - then returns still_running with its task id, which the model
# waits on with cloud.tasks.poll (bounded the same way) instead of the client
# timing out (many give up after 60 s) and the model starting it again. Raise it only if every client you
# use waits longer; 0 waits until done. Progress is reported while waiting.
# Scripts (execute_code) are limited by GCORE_CODE_TIMEOUT instead.
# GCORE_WAIT_TIMEOUT=50

# The SDK's own limit for one task poll. Default: 7200 (2 hours). Rarely needed:
# GCORE_WAIT_TIMEOUT returns much sooner.
# GCORE_POLLING_TIMEOUT_SECONDS=7200

# ------------------------------------------------------------ tool surface
# Default: dynamic - 6 tools (search, schema, call by risk level, execute_code)
# reach the whole API for ~1.3k tokens. If only GCORE_TOOLS is set, the default
# becomes direct: one tool per matched operation. Use direct for a small, fixed
# set of operations, or clients that handle many tools better than search.
# GCORE_MCP_ROUTING is an older spelling.
# GCORE_MCP_MODE=dynamic

# Glob patterns over SDK paths. Every operation, with its access class, is listed
# in https://github.com/G-Core/gcore-mcp-server/blob/main/docs/OPERATIONS.md
# (or run gcore-mcp-server --list 'PATTERN' to see what a pattern matches).
# Direct mode: the tools to expose. Dynamic mode: limits what search and calls
# reach. Default: unset (everything). A value matching nothing stops the server.
# GCORE_TOOLS=cloud.instances.*,dns.zones.*

# execute_code: sandboxed Python scripts for multi-call tasks and filtering big
# lists. Default: true. Set false if your client can't approve it separately and
# you want every API call to be a visible tool call.
# GCORE_CODE_EXECUTION=true
# Let scripts make changes. Default: false (scripts only read). Calls that need
# approval still stop the script. Enable for bulk changes you'd approve anyway.
# GCORE_CODE_WRITES=false
# Seconds a script may run. Default: 55. Keep it below your client's tool-call
# timeout (60 s for most), or the client gives up first.
# GCORE_CODE_TIMEOUT=55

# Results longer than this many characters of JSON (as the model receives them:
# SDK field names, empty fields dropped) are trimmed, with a note saying how many
# items were left out and how to narrow the call. Applies to each tool result and
# to what an execute_code script returns, not to data inside a script.
# Default: 40000, about 16k tokens: ~30 instances or volumes, ~80 floating IPs,
# ~13 CDN resources, ~4 security groups (their rules make them large).
# Lower it to save context; 0 turns trimming off.
# GCORE_MAX_RESULT_CHARS=40000

# ------------------------------------------------------------------ safety
# Only read operations run. Default: false, but true with GCORE_TRANSPORT=http
# (set false there explicitly to allow changes). Use for exploration and audits.
# GCORE_READ_ONLY=false

# What needs the user's approval. Default: destructive (deletes, resizes, reboots,
# purges...). writes: every change. none: no prompts - only for trusted
# automation; read-only mode and the deny-list still apply.
# GCORE_CONFIRM=destructive

# How approval is asked. Default: client - the client's own prompt when it
# supports one (MCP elicitation), otherwise the model asks you and retries with a
# one-time token. model: always the token round trip. Use model for headless
# runs (claude -p, CI agents), which cancel client prompts.
# GCORE_ELICITATION=false is an older spelling of model.
# GCORE_CONFIRM_VIA=client

# Operations to block completely; search still lists them, marked blocked, so a
# model doesn't look for another way (same patterns and list as
# GCORE_TOOLS). Default: unset. Use for operations whose results shouldn't reach
# the model (secrets, kubeconfigs) or must never run.
# GCORE_DENY_TOOLS=cloud.k8s.clusters.kubeconfig.*,cloud.k8s.clusters.get_certificate,*.secrets.*,*credentials*,*.access_keys.*,iam.api_tokens.*

# --------------------------------------------------------------- transport
# Default: stdio (the client starts the server). http: one long-running server
# on 127.0.0.1 for several clients. HTTP clients are NOT authenticated and it is
# read-only by default (see GCORE_READ_ONLY); never expose the port.
# GCORE_TRANSPORT=stdio
# HTTP port. Default: 8000. The address is always 127.0.0.1.
# GCORE_PORT=8000
# Extra Host / Origin values HTTP requests may carry (glob patterns, no ports).
# Default: none - loopback names, the bound address and same-origin requests are
# always accepted. Needed only behind a local reverse proxy with its own name.
# GCORE_ALLOWED_HOSTS=
# GCORE_ALLOWED_ORIGINS=

# ------------------------------------------- tests and evals (contributors)
# tests/live, the read sweep and live scenarios. Use a TEST account: these create
# and delete resources (scenarios: VMs, volumes, IPs, a load balancer, a DNS zone,
# a CDN resource), all named mcp-test-* / mcp-scn-*.
# GCORE_LIVE_API_KEY=
# GCORE_LIVE_PROJECT_ID=
# GCORE_LIVE_REGION_ID=
# A key without write access, for the permission-error test. Optional.
# GCORE_LIVE_RESTRICTED_API_KEY=
# Optional; scenarios that need one are skipped without it.
# GCORE_LIVE_REGION2_ID=          # a second region (duplicate names across regions)
# GCORE_LIVE_OTHER_PROJECT_ID=    # a non-default project
# GCORE_LIVE_DNS_ZONE=            # an existing zone; scenarios create a child zone
# GCORE_LIVE_FLAVOR=g1-standard-1-2  # flavor for scenario fixture VMs

# evals/run_evals.py only: it runs its own agent loop on the Anthropic API.
# Live tests and scenarios don't need it: scenarios use the harnesses' own
# logins (claude, codex, opencode), which is how other models are covered.
# ANTHROPIC_API_KEY=
